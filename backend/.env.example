APP_NAME="SPIKE Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# In production: APP_ENV=production, APP_DEBUG=false, an https:// APP_URL.
# Session cookies are then Secure automatically (HTTPS is required).

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite locally (database/database.sqlite). MySQL works too: set DB_CONNECTION=mysql + DB_HOST/DB_DATABASE/...
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- SPIKE Lab access ---
# One shared password for the whole site. Empty = nobody can get in.
# This is an access barrier, not a per-child account.
LAB_ACCESS_PASSWORD=
LAB_SESSION_HOURS=8
LAB_LOGIN_MAX_ATTEMPTS=5
LAB_LOGIN_COOLDOWN_SECONDS=60

# --- Abuse / cost limits (per browser session per hour; an IP gets 6x) ---
LAB_MAX_AI_REQUESTS_PER_HOUR=30
LAB_MAX_UPLOAD_MB=8
LAB_MAX_SCREENSHOTS_PER_PROJECT=6
LAB_MAX_IMAGE_DIMENSION=4096
LAB_MAX_CONCURRENT_ANALYSES=2
LAB_MAX_UPLOADS_PER_HOUR=60
LAB_MAX_PROJECTS_PER_SESSION_PER_HOUR=30
# Projects (and their screenshots) not saved for this many days are deleted by `php artisan lab:prune`.
LAB_RETENTION_DAYS=30

# --- Screenshot recognition (vision) ---
# mock   = offline stored example, does not read the picture
# openai = OpenAI Chat Completions with image input (needs key + a vision-capable model)
VISION_DRIVER=mock
VISION_TIMEOUT=90
OPENAI_API_KEY=
OPENAI_MODEL=

# --- AI Brain gateway (text only: block explanations, scene proposals) ---
# The gateway picks the model from the token; AIBRAIN_MODEL is informational.
AIBRAIN_BASE_URL=
AIBRAIN_API_KEY=
AIBRAIN_MODEL=
AIBRAIN_TIMEOUT=60
