APP_NAME="SPIKE Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# In production: APP_ENV=production, APP_DEBUG=false, an https:// APP_URL.
# Session cookies are then Secure automatically (HTTPS is required).

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite locally (database/database.sqlite). MySQL works too: set DB_CONNECTION=mysql + DB_HOST/DB_DATABASE/...
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- SPIKE Lab access ---
# One shared password for the whole site. Empty = nobody can get in.
# This is an access barrier, not a per-child account.
LAB_ACCESS_PASSWORD=
LAB_SESSION_HOURS=8
LAB_LOGIN_MAX_ATTEMPTS=5
LAB_LOGIN_COOLDOWN_SECONDS=60

# --- Abuse / cost limits (per browser session per hour; an IP gets 6x) ---
LAB_MAX_AI_REQUESTS_PER_HOUR=30
LAB_MAX_UPLOAD_MB=8
LAB_MAX_SCREENSHOTS_PER_PROJECT=6
LAB_MAX_IMAGE_DIMENSION=4096
LAB_MAX_CONCURRENT_ANALYSES=2
LAB_MAX_UPLOADS_PER_HOUR=60
LAB_MAX_PROJECTS_PER_SESSION_PER_HOUR=30
# Projects (and their screenshots) not saved for this many days are deleted by `php artisan lab:prune`.
LAB_RETENTION_DAYS=30

# --- Public demo (optional) ---
# true = anyone can try the app at /demo without the password. Demo visitors only see their own
# projects, the AI is always the offline example, and their projects are deleted after a day.
LAB_DEMO_ENABLED=false
LAB_DEMO_RETENTION_HOURS=24

# --- AI provider ---
# One provider does every AI job: reading screenshots, explaining a block, suggesting a mat.
# mock   = no AI at all: uploads show a stored example, the text helpers are switched off
# openai = OpenAI (needs OPENAI_API_KEY and a model that accepts images)
# gemini = Google Gemini (needs GEMINI_API_KEY and a model that accepts images)
AI_PROVIDER=mock
AI_TIMEOUT=90

OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: any other service that speaks the OpenAI chat-completions format
# OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=
